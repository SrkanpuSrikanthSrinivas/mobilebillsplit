# Neon Postgres connection string (from neon.tech dashboard)
DATABASE_URL="postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require"

# Secret you type on the dashboard to upload bills / mark payments
ADMIN_KEY="pick-a-long-random-string"

# Unguessable slug for the read-only family link: /share/<this>
SHARE_TOKEN="another-long-random-string"
